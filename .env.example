# nfofetch 示例环境变量配置
#
# 将本文件复制为 `.env`，并根据自己的环境修改后使用：
# cp .env.example .env

# 用户设置持久化路径（JSON 文件），默认 ~/.config/nfofetch/settings.json
# NFOFETCH_SETTINGS_PATH=/config/settings.json

# Web 界面中文件浏览器的根目录（容器内路径）
# NFOFETCH_BROWSE_ROOT=/data/media

# 可选：自定义 HTTP User-Agent，避免部分站点直接 403
# NFOFETCH_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:117.0) Gecko/20100101 Firefox/117.0"

# 可选：访问 javdb 时使用的 HTTP 代理，例如 http://127.0.0.1:7890
# NFOFETCH_HTTP_PROXY=http://127.0.0.1:7890

# 访问 javdb 时使用的 Cookie（含 cf_clearance 等）
# 请从浏览器开发者工具中复制整段 Cookie 字符串填入这里。
# NFOFETCH_JAVDB_COOKIE=theme=auto; locale=zh; over18=1; list_mode=v; cf_clearance=REPLACE_ME; _jdb_session=REPLACE_ME
# 注意：值不要加引号（"），YAML 的 list 格式 - KEY=value 中引号会被当作值的一部分

# 可选：javdb 镜像域名，默认 javdb565.com。镜像变动时无需改代码。
# NFOFETCH_JAVDB_MIRROR=javdb565.com

# 可选：extrafanart 最大保存数量，设为 0 完全禁用（默认 8）
# NFOFETCH_MAX_EXTRA_IMAGES=8

# 可选：单个 HTTP 请求超时秒数（默认 20）
# NFOFETCH_HTTP_TIMEOUT=20

# 可选：extrafanart 批量下载总超时秒数（默认 120）
# NFOFETCH_BATCH_TIMEOUT=120

# 可选：串行写入图片（true 时 poster、fanart、extrafanart 逐个下载，避免 FUSE 网络文件系统并发 I/O 断开）
# 默认 false，网络挂载（如 fnos + 115 网盘）不稳定时设置为 true
# NFOFETCH_SERIAL_WRITES=false

# 可选：启用目录锁防止同目录并发刮削（多用户 Web 场景需要，单人使用建议关闭）
# 默认 false，避免 FUSE 网络文件系统上不必要的锁文件 I/O
# NFOFETCH_LOCK_ENABLED=false

# 可选：日志等级（DEBUG / INFO / WARNING / ERROR，默认 WARNING）
# NFOFETCH_LOG_LEVEL=WARNING

